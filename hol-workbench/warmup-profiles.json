    "light": {
      "basis_id": "hol.light.default.v3",
      "cwd_policy": "global_hol_lib",
      "summary": "Default small warm basis for ordinary arithmetic, real algebra, and ring scratch work.",
      "expected_load": "Small-to-moderate global HOL load; warm this before general short proof-edit loops.",
      "recommended_pool_size": 2,
      "orbstack_public_capacity": 2,
      "scratch_convention": "Use as the default non-project profile for small standalone lemmas, REAL_ARITH/REAL_RING, calc_rat, and ring-theory experiments.",
      "output_profile": "ringtheory",
      "useful_operations": [
        {
          "name": "REAL_ARITH_TAC",
          "hint": "linear real arithmetic and inequalities"
        },
        {
          "name": "REAL_RING",
          "hint": "conversion for polynomial real identities; not a tactic by itself"
        },
        {
          "name": "CONV_TAC REAL_RING",
          "hint": "invoke the REAL_RING conversion on the current goal"
        },
        {
          "name": "REAL_FIELD",
          "hint": "field identities after proving denominators nonzero"
        },
        {
          "name": "RING_TAC",
          "hint": "ordinary real/complex polynomial normalization preserved across the full light preload"
        },
        {
          "name": "HOL_WORKBENCH_ABSTRACT_RING_TAC",
          "hint": "abstract-ring tactic retained from Library/ringtheory.ml"
        },
        {
          "name": "MESON_TAC[]",
          "hint": "first-order and propositional closure"
        },
        {
          "name": "ASM_SIMP_TAC[]",
          "hint": "simplify with assumptions"
        },
        {
          "name": "MATCH_MP_TAC",
          "hint": "apply a theorem by conclusion shape"
        },
        {
          "name": "REWRITE_TAC[...]",
          "hint": "unfold definitions and apply equalities"
        }
      ],
      "base_lines": [
        "needs \"calc_rat.ml\";;",
        "prioritize_real();;",
        "let HOL_WORKBENCH_REAL_POLY_RING_TAC = CONV_TAC REAL_RING;;",
        "needs \"Library/ringtheory.ml\";;",
        "let HOL_WORKBENCH_ABSTRACT_RING_TAC = RING_TAC;;",
        "let RING_TAC = HOL_WORKBENCH_REAL_POLY_RING_TAC;;",
        "let HOL_WORKBENCH_LIGHT_RING_SMOKE = prove(`!x y:real. (x + y) pow 2 = x pow 2 + &2 * x * y + y pow 2`,RING_TAC);;",
        "let HOL_WORKBENCH_LIGHT_WARMUP = prove(`T`,MESON_TAC[]);;"
      ]
    },
