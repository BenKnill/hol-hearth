#!/usr/bin/env bash
set -euo pipefail
[[ "$(uname -s)" == Linux ]] || { echo 'HOL Hearth requires Linux. On macOS, see docs/macos.md (run inside an OrbStack Linux machine).' >&2; exit 2; }
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
export HOL_HEARTH_LAUNCHER="$root/hearth"
operation=${1:---help}
if (( $# )); then shift; fi
case "$operation" in
  -h|--help|help)
    cat <<'HELP'
HOL Hearth — warm HOL Light proof checks on Linux

  hearth check                         Check the tool without starting HOL
  hearth smoke                         Check the installation (no HOL or CRIU)
  hearth setup [--check]                Build the first light profile from source
  hearth prove FILE.ml --run-root DIR   Check a source and record a receipt
  hearth prove LEAF.ml --basis DEPS.ml --run-root DIR  Reuse a checked project dependency
  hearth inspect DIR                   Read a recorded result
  hearth reopen DIR --binding NAME --out FILE.ml  Prepare a diagnostic scratch
  hearth export-replay DIR [--out FILE.sh]  Write the plain HOL Light replay command for a receipt
  hearth prove FILE.ml --loop           Record checks after project edits
  hearth watch FILE.ml                  Same as prove --loop
  hearth leaf-needs FILE.ml --profile P  Compare a leaf's needs with a profile recipe
  hearth profiles                      List proof profiles
  hearth doctor [--profile PROFILE]     Optional snapshot and queue check
  hearth configure OPTIONS             Set local HOL and CRIU paths
  hearth status [--profile PROFILE]     Show active proofs and the admission queue
  hearth cancel ATTEMPT_ID              Interrupt one attempt like Ctrl-C; the warm seat stays
  hearth basis [retire KEY|--all]       List or retire prepared --basis states

Runtime: Linux, Python 3.11+, a compatible local HOL/CRIU warm profile.
One checked replay path serves single runs and project watching.
HELP
    ;;
  --version) echo 'HOL Hearth 0.2.0' ;;
  prove|inspect|reopen|export-replay|leaf-needs|smoke|configure)
    exec "$root/hol-workbench/bin/workbench-python" "$operation" "$@" ;;
  profiles|doctor|status|cancel|basis|watch)
    exec "$root/hol-workbench/bin/workbench-python" prove "$operation" "$@" ;;
  check|setup)
    python=${HOL_WORKBENCH_PYTHON:-$(command -v python3)}
    exec "$python" -I -B "$root/dev/$operation.py" "$@" ;;
  *) echo "Unknown command: $operation. Run hearth --help." >&2; exit 2 ;;
esac
